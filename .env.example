# Copy to .env for `docker compose`. Compose substitutes these into the stack.

# --- Postgres ---
POSTGRES_USER=obscura
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=obscura

# --- Client exposure ---
# Host port the client (nginx) is published on.
CLIENT_PORT=8080
# Public origin the browser loads the app from — must match for CORS.
# In real prod set this to your https domain, e.g. https://notes.example.com
CLIENT_ORIGIN=http://localhost:8080
